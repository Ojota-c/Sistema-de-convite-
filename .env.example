# =============================================================================
# Variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores:
#
#   cp .env.example .env.local
#
# O arquivo .env.local está no .gitignore e NUNCA deve ser commitado.
# As mesmas variáveis precisam ser cadastradas na Vercel, em
# Settings > Environment Variables, para o deploy funcionar.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------

# URL do projeto no Supabase.
# Onde achar: Supabase > seu projeto > Project Settings > Data API > Project URL.
# Formato: https://abcdefghijklmnop.supabase.co
#
# Note que o nome NÃO começa com NEXT_PUBLIC_. Isso é proposital: o banco é
# acessado somente pelo servidor, e nenhuma informação de conexão precisa
# chegar ao navegador do convidado.
SUPABASE_URL=

# Chave service_role do Supabase.
# Onde achar: Supabase > Project Settings > API Keys > service_role (clique em
# "Reveal" para ver o valor).
#
# ATENÇÃO: esta chave ignora as políticas de RLS e dá acesso total ao banco.
# Ela só pode viver no servidor. Se vazar, vá em API Keys e gere outra.
SUPABASE_SERVICE_ROLE_KEY=

# Nome do bucket do Storage onde a imagem do convite é guardada.
# O bucket é criado pela migration 0003_storage.sql. Só mude este valor se
# tiver criado o bucket com outro nome.
SUPABASE_STORAGE_BUCKET=convite


# -----------------------------------------------------------------------------
# PAINEL DO ORGANIZADOR
# -----------------------------------------------------------------------------

# Senha única de acesso ao painel em /admin.
# Mínimo de 8 caracteres. Escolha algo que você não use em outro lugar.
# Para gerar uma senha forte:
#   openssl rand -base64 18
ADMIN_PASSWORD=

# Segredo usado para assinar o cookie de sessão do painel (HMAC SHA-256).
# Mínimo de 32 caracteres. Não precisa ser memorizável, ninguém digita isso.
# Para gerar:
#   openssl rand -base64 48
#
# Trocar este valor derruba todas as sessões abertas, o que é justamente o
# que você quer fazer se achar que alguém entrou no painel.
ADMIN_SESSION_SECRET=


# -----------------------------------------------------------------------------
# ENDEREÇO DO SITE
# -----------------------------------------------------------------------------

# URL pública do site, sem barra no final.
# É a base dos links enviados aos convidados e das imagens de prévia do
# WhatsApp, por isso precisa ser o endereço real, acessível pela internet.
#
# Em desenvolvimento:  http://localhost:3000
# Em produção:         https://seu-projeto.vercel.app
#                      ou https://seudominio.com.br
#
# Na Vercel esta variável é opcional: sem ela o sistema usa o endereço do
# próprio deploy. Ainda assim vale preencher, para os links não mudarem a
# cada deploy de prévia.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
